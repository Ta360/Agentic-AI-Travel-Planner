"""
Budget Estimation Tool for LangChain Agent.
Calculates total trip cost based on flight, hotel, and per-day expenses.
"""

from langchain.tools import tool

# Average daily expense estimates per city (food + local transport + misc) in INR
DAILY_EXPENSES = {
    "goa": 1200,
    "mumbai": 1500,
    "delhi": 1000,
    "bangalore": 1100,
    "manali": 900,
    "jaipur": 800,
    "kolkata": 900,
    "hyderabad": 950,
    "chennai": 1000,
    "agra": 700,
}

DEFAULT_DAILY_EXPENSE = 1000  # fallback for unknown cities


@tool
def budget_estimation_tool(
    destination: str,
    flight_cost: int,
    hotel_cost_per_night: int,
    num_days: int,
    num_people: int = 1
) -> str:
    """
    Estimate the total cost for a trip including flights, hotel, and daily expenses.

    Args:
        destination (str): Destination city name (e.g., 'Goa', 'Manali').
        flight_cost (int): One-way flight cost per person in INR.
        hotel_cost_per_night (int): Hotel cost per night in INR.
        num_days (int): Duration of trip in days.
        num_people (int): Number of travellers. Default is 1.

    Returns:
        str: Detailed budget breakdown and total estimated cost.
    """
    try:
        num_days = max(1, num_days)
        num_people = max(1, num_people)

        daily_rate = DAILY_EXPENSES.get(destination.lower(), DEFAULT_DAILY_EXPENSE)

        # Cost calculations
        total_flight = flight_cost * num_people * 2  # round-trip for all people
        total_hotel = hotel_cost_per_night * num_days
        total_daily = daily_rate * num_days * num_people
        grand_total = total_flight + total_hotel + total_daily

        per_person_total = grand_total / num_people

        lines = [
            f" Budget Breakdown — {destination.title()} Trip ({num_days} Days, {num_people} Person(s)):\n",
            f"  Flights (Round-Trip × {num_people}):  ₹{total_flight:,}",
            f"   └─ ₹{flight_cost:,}/person × {num_people} × 2 (return)",
            f"  Hotel ({num_days} nights):             ₹{total_hotel:,}",
            f"   └─ ₹{hotel_cost_per_night:,}/night × {num_days} nights",
            f"  Food & Local Travel:              ₹{total_daily:,}",
            f"   └─ ≈₹{daily_rate:,}/day × {num_days} days × {num_people} person(s)",
            f"\n{'─' * 45}",
            f" TOTAL ESTIMATED COST:             ₹{grand_total:,}",
        ]

        if num_people > 1:
            lines.append(f"  Per Person Cost:                  ₹{per_person_total:,.0f}")

        lines.append(
            "\n  Note: Costs are estimates. Entry fees for attractions, "
            "shopping, and premium dining are not included."
        )

        return "\n".join(lines)

    except Exception as e:
        return f"Error estimating budget: {str(e)}"

