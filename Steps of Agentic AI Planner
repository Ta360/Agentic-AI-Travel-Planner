"""
Travel Planning Agent — LangChain ReAct / Tool-Calling Agent.
Orchestrates all tools to autonomously produce a complete trip itinerary.
"""

import os
from langchain_openai import ChatOpenAI
from langchain.agents import AgentExecutor, create_openai_tools_agent
from langchain.prompts import ChatPromptTemplate, MessagesPlaceholder
from langchain.schema import SystemMessage

from tools import ALL_TOOLS

# ─── System Prompt ──────────────────────────────────────────────────────────────
SYSTEM_PROMPT = """You are an expert AI Travel Planning Assistant powered by LangChain.

Your job is to help users plan complete, optimized, personalized trips.

When given a travel query you MUST:
1. Search for available flights from the source to destination.
2. Recommend suitable hotels at the destination.
3. Discover top places and attractions to visit.
4. Fetch the weather forecast for the travel dates.
5. Estimate the total budget for the trip.
6. Synthesize all results into a structured, day-wise itinerary.

Output Format:
─────────────────────────────────────────────────────────
🌍  TRIP SUMMARY
   Destination | Duration | Travel Dates | Travellers

✈️  FLIGHT DETAILS
   Selected flight with price, timing, and airline

🏨  HOTEL RECOMMENDATION
   Hotel name, area, rating, price/night

🌤️  WEATHER FORECAST
   Day-by-day forecast

📅  DAY-WISE ITINERARY
   Day 1: Morning | Afternoon | Evening
   Day 2: ...

💰  BUDGET BREAKDOWN
   Flights | Hotel | Daily Expenses | Total

🤖  REASONING
   Brief explanation of key choices made
─────────────────────────────────────────────────────────

Always be helpful, specific, and practical. If a city is not in the dataset,
gracefully inform the user and suggest alternatives."""


def build_agent() -> AgentExecutor:
    """
    Build and return a LangChain Tool-Calling AgentExecutor.

    Returns:
        AgentExecutor: Ready-to-use travel planning agent.

    Raises:
        EnvironmentError: If OPENAI_API_KEY is not set.
    """
    api_key = os.getenv("OPENAI_API_KEY")
    if not api_key:
        raise EnvironmentError(
            "OPENAI_API_KEY environment variable is not set. "
            "Please add it to your .env file."
        )

    llm = ChatOpenAI(
        model="gpt-4o-mini",
        temperature=0.3,
        openai_api_key=api_key,
    )

    prompt = ChatPromptTemplate.from_messages([
        SystemMessage(content=SYSTEM_PROMPT),
        MessagesPlaceholder(variable_name="chat_history", optional=True),
        ("human", "{input}"),
        MessagesPlaceholder(variable_name="agent_scratchpad"),
    ])

    agent = create_openai_tools_agent(llm=llm, tools=ALL_TOOLS, prompt=prompt)

    executor = AgentExecutor(
        agent=agent,
        tools=ALL_TOOLS,
        verbose=True,
        max_iterations=10,
        handle_parsing_errors=True,
        return_intermediate_steps=True,
    )

    return executor


def run_agent(query: str) -> dict:
    """
    Run the travel agent with a natural language query.

    Args:
        query (str): User's travel planning request.

    Returns:
        dict: Contains 'output' (final answer) and 'intermediate_steps'.
    """
    agent = build_agent()
    result = agent.invoke({"input": query})
    return result

