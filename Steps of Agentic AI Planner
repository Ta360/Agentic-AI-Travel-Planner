"""
Flight Search Tool for LangChain Agent.
Reads flights.json and returns filtered, ranked flight options.
"""

import json
import os
from langchain.tools import tool

DATA_PATH = os.path.join(os.path.dirname(__file__), "..", "data", "flights.json")


def _load_flights() -> list[dict]:
    """Load flights data from JSON file."""
    with open(DATA_PATH, "r") as f:
        return json.load(f)


@tool
def flight_search_tool(source: str, destination: str, preference: str = "cheapest") -> str:
    """
    Search for available flights between two cities.

    Args:
        source (str): Departure city name (e.g., 'Delhi', 'Mumbai').
        destination (str): Arrival city name (e.g., 'Goa', 'Bangalore').
        preference (str): Sorting preference — 'cheapest' or 'fastest'. Default is 'cheapest'.

    Returns:
        str: Formatted string listing top flight options with details.
    """
    try:
        flights = _load_flights()

        # Filter flights by source and destination (case-insensitive)
        matched = [
            f for f in flights
            if f["source"].lower() == source.lower()
            and f["destination"].lower() == destination.lower()
        ]

        if not matched:
            return (
                f"No flights found from {source} to {destination}. "
                "Please check city names or try alternate routes."
            )

        # Sort based on preference
        if preference.lower() == "fastest":
            matched.sort(key=lambda x: x["duration_min"])
        else:
            matched.sort(key=lambda x: x["price"])

        # Build response string
        lines = [f"  Available Flights: {source} → {destination}\n"]
        for i, f in enumerate(matched[:5], 1):
            lines.append(
                f"{i}. {f['airline']} ({f['flight_no']}) | "
                f"Dep: {f['departure']} → Arr: {f['arrival']} | "
                f"Duration: {f['duration_min']} min | "
                f"₹{f['price']:,} ({f['class']}) | "
                f"Seats: {f['seats_available']}"
            )

        top = matched[0]
        lines.append(
            f"\n Recommended ({preference}): {top['airline']} ({top['flight_no']}) "
            f"at ₹{top['price']:,}, departing {top['departure']}."
        )
        return "\n".join(lines)

    except FileNotFoundError:
        return "Error: flights.json data file not found. Please check the data directory."
    except Exception as e:
        return f"Error searching flights: {str(e)}"

