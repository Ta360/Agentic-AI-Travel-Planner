"""
Hotel Recommendation Tool for LangChain Agent.
Reads hotels.json and returns filtered, ranked hotel suggestions.
"""

import json
import os
from langchain.tools import tool

DATA_PATH = os.path.join(os.path.dirname(__file__), "..", "data", "hotels.json")


def _load_hotels() -> list[dict]:
    """Load hotels data from JSON file."""
    with open(DATA_PATH, "r") as f:
        return json.load(f)


@tool
def hotel_recommendation_tool(
    city: str,
    budget_per_night: int = 10000,
    min_rating: float = 3.5,
    preference: str = "best_rated"
) -> str:
    """
    Search and recommend hotels in a given city based on budget and rating filters.

    Args:
        city (str): Target city name (e.g., 'Goa', 'Mumbai', 'Delhi').
        budget_per_night (int): Maximum price per night in INR. Default is 10000.
        min_rating (float): Minimum acceptable rating (out of 5). Default is 3.5.
        preference (str): 'best_rated' or 'cheapest'. Default is 'best_rated'.

    Returns:
        str: Formatted string listing top hotel recommendations.
    """
    try:
        hotels = _load_hotels()

        # Filter by city, budget, and rating
        matched = [
            h for h in hotels
            if h["city"].lower() == city.lower()
            and h["price_per_night"] <= budget_per_night
            and h["rating"] >= min_rating
        ]

        if not matched:
            return (
                f"No hotels found in {city} within ₹{budget_per_night:,}/night "
                f"with rating ≥ {min_rating}. Consider increasing your budget or relaxing filters."
            )

        # Sort based on preference
        if preference.lower() == "cheapest":
            matched.sort(key=lambda x: x["price_per_night"])
        else:
            matched.sort(key=lambda x: x["rating"], reverse=True)

        # Build response
        lines = [f"  Hotel Recommendations in {city}:\n"]
        for i, h in enumerate(matched[:4], 1):
            amenities = ", ".join(h["amenities"][:4])
            lines.append(
                f"{i}. {h['name']} {h['stars']}-star | {h['area']} | "
                f"₹{h['price_per_night']:,}/night | Rating: {h['rating']}/5 | "
                f"Amenities: {amenities} | Rooms: {h['rooms_available']}"
            )

        top = matched[0]
        lines.append(
            f"\n Recommended: {top['name']} ({top['stars']}-star) in {top['area']} "
            f"at ₹{top['price_per_night']:,}/night — Rating: {top['rating']}/5."
        )
        return "\n".join(lines)

    except FileNotFoundError:
        return "Error: hotels.json data file not found. Please check the data directory."
    except Exception as e:
        return f"Error searching hotels: {str(e)}"

