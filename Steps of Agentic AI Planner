"""
Places Discovery Tool for LangChain Agent.
Reads places.json and recommends attractions based on city and type filters.
"""

import json
import os
from langchain.tools import tool

DATA_PATH = os.path.join(os.path.dirname(__file__), "..", "data", "places.json")


def _load_places() -> list[dict]:
    """Load places data from JSON file."""
    with open(DATA_PATH, "r") as f:
        return json.load(f)


@tool
def places_discovery_tool(
    city: str,
    place_type: str = "all",
    top_n: int = 5
) -> str:
    """
    Discover top tourist attractions and places of interest in a city.

    Args:
        city (str): Target city name (e.g., 'Goa', 'Delhi', 'Manali').
        place_type (str): Category filter — 'Beach', 'Heritage', 'Nature', 'Adventure',
                          'Historical', 'Shopping', 'Religious', 'Cultural', 'Landmark',
                          'Promenade', 'Experience', or 'all'. Default is 'all'.
        top_n (int): Number of top places to return. Default is 5.

    Returns:
        str: Formatted list of recommended places with details.
    """
    try:
        places = _load_places()

        # Filter by city
        city_places = [p for p in places if p["city"].lower() == city.lower()]

        if not city_places:
            return f"No places found for {city}. Please check the city name."

        # Filter by type if specified
        if place_type.lower() != "all":
            filtered = [
                p for p in city_places
                if p["type"].lower() == place_type.lower()
            ]
            if not filtered:
                filtered = city_places  # fall back to all places in city
        else:
            filtered = city_places

        # Sort by rating descending
        filtered.sort(key=lambda x: x["rating"], reverse=True)

        # Build response
        lines = [f"  Top Places to Visit in {city}:\n"]
        for i, p in enumerate(filtered[:top_n], 1):
            fee = f"₹{p['entry_fee']}" if p["entry_fee"] > 0 else "Free Entry"
            lines.append(
                f"{i}. {p['name']} [{p['type']}] | Rating: {p['rating']}/5 | "
                f"Entry: {fee} | Best Time: {p['best_time']} | "
                f"Duration: ~{p['duration_hrs']} hrs\n"
                f"    {p['description']}"
            )

        return "\n\n".join(lines)

    except FileNotFoundError:
        return "Error: places.json data file not found. Please check the data directory."
    except Exception as e:
        return f"Error discovering places: {str(e)}"

