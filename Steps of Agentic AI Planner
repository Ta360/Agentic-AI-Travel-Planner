"""
Utility helpers for AI Travel Planning Assistant.
Provides input validation, formatting, and query parsing.
"""

import re
from datetime import datetime, timedelta


# ─── Query Parsing ──────────────────────────────────────────────────────────────

KNOWN_CITIES = [
    "goa", "mumbai", "delhi", "bangalore", "manali",
    "jaipur", "kolkata", "hyderabad", "chennai", "agra",
]


def extract_cities_from_query(query: str) -> dict:
    """
    Attempt to extract source/destination cities from a free-text query.

    Args:
        query (str): User's natural language travel query.

    Returns:
        dict: {'source': str or None, 'destination': str or None}
    """
    query_lower = query.lower()
    found = [city for city in KNOWN_CITIES if city in query_lower]

    result = {"source": None, "destination": None}

    # Heuristic: "from X to Y" pattern
    match = re.search(r"from\s+(\w+)\s+to\s+(\w+)", query_lower)
    if match:
        result["source"] = match.group(1).title()
        result["destination"] = match.group(2).title()
    elif len(found) >= 2:
        result["source"] = found[0].title()
        result["destination"] = found[1].title()
    elif len(found) == 1:
        result["destination"] = found[0].title()

    return result


def extract_days_from_query(query: str) -> int:
    """
    Extract trip duration (in days) from query text.

    Args:
        query (str): User's natural language travel query.

    Returns:
        int: Number of days (default 3 if not found).
    """
    # Match patterns like "3 days", "5-day", "for a week"
    match = re.search(r"(\d+)\s*(?:day|days|night|nights)", query.lower())
    if match:
        return int(match.group(1))
    if "week" in query.lower():
        return 7
    if "weekend" in query.lower():
        return 2
    return 3  # sensible default


# ─── Formatting Helpers ─────────────────────────────────────────────────────────

def format_currency(amount: int) -> str:
    """Format an integer amount as Indian Rupees string."""
    return f"₹{amount:,}"


def get_travel_dates(start_offset_days: int = 7, num_days: int = 3) -> tuple[str, str]:
    """
    Generate start and end travel date strings.

    Args:
        start_offset_days (int): Days from today to start. Default 7.
        num_days (int): Trip duration. Default 3.

    Returns:
        tuple[str, str]: (start_date, end_date) as 'YYYY-MM-DD' strings.
    """
    start = datetime.today() + timedelta(days=start_offset_days)
    end = start + timedelta(days=num_days - 1)
    return start.strftime("%Y-%m-%d"), end.strftime("%Y-%m-%d")


def validate_query(query: str) -> tuple[bool, str]:
    """
    Basic validation of the travel query.

    Args:
        query (str): User input.

    Returns:
        tuple[bool, str]: (is_valid, error_message)
    """
    if not query or len(query.strip()) < 10:
        return False, "Query too short. Please describe your travel plans in more detail."
    if len(query) > 1000:
        return False, "Query too long. Please keep it under 1000 characters."
    return True, ""


